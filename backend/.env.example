# Serial connection is opened only after POST /api/esp32/connect.
SERIAL_PORT=COM3
BAUD_RATE=115200
SERIAL_TIMEOUT=2.0

# Camera is opened only after POST /api/camera/start.
CAMERA_INDEX=0

# Pretrained COCO detector; weights download on the first inference if absent.
YOLO_MODEL=yolo26n.pt
DETECTION_CONFIDENCE=0.25
DETECTION_IMAGE_SIZE=640

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
